RESEND_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Your verified Resend sending domain. Emails go out as approvals@, decisions@, login@ and hello@ this domain.
EMAIL_FROM_DOMAIN=

# Public demos only: caps requests per key per day, locks the recipient to the key owner,
# and limits shared email budgets. Leave empty when self-hosting.
DEMO_MODE=

# Set to true to allow webhooks to http or private-network URLs (self-hosting behind a firewall).
ALLOW_PRIVATE_WEBHOOKS=
